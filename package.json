  "scripts": {
    "start:dev": "next dev --turbopack -p 3000",
    "start:prod": "next start",
    "build:prod": "next build",
    "build:pkg": "npm run build:prod",
    "fmt:format": "prettier --write --ignore-path .gitignore .",
    "deps:install": "npm install --no-audit --prefer-offline --verbose --no-fund",
    "deps:update": "npm-check-updates -u && npm run deps:install",
    "type:check": "tsc --noEmit",
    "test:unit": "node --test test/unit/*.test.mjs",
    "coverage": "c8 --all --extension .ts --include src/lib/client/documents.ts --reporter=lcov --reporter=text --reports-dir=coverage npm run test:unit",
    "cloudflare:deploy": "npx --yes wrangler@4 deploy --config wrangler.toml"
  },
