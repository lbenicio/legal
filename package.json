{
  "name": "legal",
  "version": "1.2.0",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "start:dev": "next dev --turbopack -p 3000",
    "start:prod": "next start",
    "build:pkg": "next build",
    "fmt:format": "prettier --write --ignore-path .gitignore .",
    "deps:install": "npm install --no-audit --prefer-offline --verbose --no-fund",
    "deps:update": "npm-check-updates -u && npm run deps:install",
    "type:check": "tsc --noEmit",
    "aws:deploy": "aws cloudformation deploy --region sa-east-1 --stack-name site-legal --template-file cloudformation.yaml",
    "aws:sync": "aws s3 sync out/ s3://legal.lbenicio.dev/ --delete",
    "aws:invalidate": "aws cloudfront create-invalidation --distribution-id EIQ6WOSFA9EUU --paths \"/*\"",
    "aws:pipe": "npm run aws:sync && npm run aws:invalidate"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.8.13",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
